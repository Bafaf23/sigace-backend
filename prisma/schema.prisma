generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
}

model Session {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText

  @@map("sessions")
}

model cdcee {
  id      Int      @id @default(autoincrement())
  name    String   @default("Sin Nombre")
  schools school[]
}

model school {
  SIG          String      @id
  school_name  String
  type         school_type
  company_name String?
  address      String
  city         String
  municipality String
  state        String
  phone        String
  email        String
  DEA_CODE     String
  RIF          String?
  is_active    Boolean     @default(true)
  subdomain    String?     @unique

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  cdceId           Int
  cdcee            cdcee              @relation(fields: [cdceId], references: [id], map: "School_cdceId_fkey")
  students         student[]
  sections         section[]
  academic_periods academic_periods[]
  teachers         teacher[]
  years            year[]
  administrators   administrator[]
  subjects         subject[]
  load_academics   load_academic[]
  user_schools     user_schools[]  

  @@map("schools")
}

model subject {
  code_subject String  @id @db.VarChar(20)
  name         String  @db.VarChar(255)
  abbreviation String? @db.VarChar(5)
  year_id      Int
  SIG          String  @db.VarChar(10)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  school school @relation(fields: [SIG], references: [SIG], onDelete: Cascade)
  year   year   @relation(fields: [year_id], references: [id], onDelete: Restrict)

  load_academics   load_academic[]
  pending_subjects pending_subject[]

  @@map("subjects")
}

model lapse {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(20)
  is_active  Boolean  @default(true)
  id_period  Int
  start_date DateTime @db.Date
  end_date   DateTime @db.Date

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  period           academic_periods  @relation(fields: [id_period], references: [id], onDelete: Cascade)
  evaluation_plans evaluation_plan[]

  @@map("lapses")
}

enum school_type {
  Privada
  Publica
}

enum gender_enum {
  M
  F
}

enum student_condition {
  regular
  nuevo_ingreso @map("Nuevo Ingreso")
  retirado
  repitiente
}

enum enrollment_status {
  activo
  aprobado
  retirado
  materia_pendiente @map("materia pendiente")
  reprobado
  pre_inscrito      @map("pre-inscrito")
}

model year {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  SIG        String   @db.VarChar(10)
  order_year Int?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  subjects    subject[]
  school      school       @relation(fields: [SIG], references: [SIG], onDelete: Cascade)
  sections    section[]
  enrollments enrollment[]

  @@map("years")
}

model users {
  id             Int      @id @default(autoincrement())
  id_card        String
  name           String
  last_name      String
  email          String   @unique
  phone          String
  pass           String
  role_id        Int
  role           role     @relation(fields: [role_id], references: [id])
  is_first_login Boolean  @default(true)
  is_active      Boolean  @default(true)

  teacher_profile       teacher?
  administrator_profile administrator?
  student_profile       student?
  auth_tokens           auth_token[]
  user_schools user_schools[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

model user_schools{
  id       Int    @id @default(autoincrement())
  user_id  Int
  SIG      String

  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  school   school    @relation(fields: [SIG], references: [SIG], onDelete: Cascade)
}

model role {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users users[]

  @@map("roles")
}

model academic_periods {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  start_date DateTime
  end_date   DateTime
  is_active  Boolean  @default(true)

  SIG                     String
  school                  school            @relation(fields: [SIG], references: [SIG])
  enrollments             enrollment[]
  sections                section[]
  lapses                  lapse[]
  pending_subjects_origin pending_subject[]
  load_academics          load_academic[]

  @@map("academic_periods")
}

model administrator {
  id      Int    @id @default(autoincrement())
  id_user Int    @unique
  SIG     String @db.VarChar(10)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user   users  @relation(fields: [id_user], references: [id], onDelete: Cascade)
  school school @relation(fields: [SIG], references: [SIG], onDelete: Cascade)

  @@map("administrators")
}

model teacher {
  id        Int     @id @default(autoincrement())
  id_user   Int     @unique
  SIG       String  @db.VarChar(10)
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user   users  @relation(fields: [id_user], references: [id], onDelete: Cascade)
  school school @relation(fields: [SIG], references: [SIG], onDelete: Cascade)

  guided_sections section[]
  load_academics  load_academic[]

  @@map("teachers")
}

model student {
  id                Int               @id @default(autoincrement())
  id_user           Int               @unique
  SIG               String            @db.VarChar(10)
  representative_id Int
  tuition_number    String            @unique @db.VarChar(255)
  allergies         String?           @db.Text
  medical_condition String?           @db.Text
  weight            Int
  height            Int
  shirt_size        String            @db.VarChar(50)
  pants_size        String            @db.VarChar(50)
  shoe_size         String            @db.VarChar(50)
  gender            gender_enum       @default(M)
  birth_date        DateTime          @db.Date
  condition         student_condition @default(nuevo_ingreso)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user             users          @relation(fields: [id_user], references: [id], onDelete: Cascade)
  school           school         @relation(fields: [SIG], references: [SIG], onDelete: Cascade)
  representative   representative @relation(fields: [representative_id], references: [id], onDelete: Restrict)
  enrollments      enrollment[]
  grades           grade[]
  pending_subjects pending_subject[]

  @@map("students")
}

model representative {
  id           Int    @id @default(autoincrement())
  document     String @unique @db.VarChar(15)
  name         String @db.VarChar(50)
  last_name    String @db.VarChar(50)
  phone        String @db.VarChar(50)
  relationship String @db.VarChar(50)
  repEmail     String @unique @db.VarChar(100)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  students student[]

  @@map("representatives")
}

model load_academic {
  id         Int    @id @default(autoincrement())
  id_teacher Int
  id_section Int
  id_period  Int
  id_subject String @db.VarChar(20)
  SIG        String @db.VarChar(10)

  created_at DateTime @default(now())

  teacher teacher          @relation(fields: [id_teacher], references: [id], onDelete: Restrict)
  section section          @relation(fields: [id_section], references: [id], onDelete: Restrict)
  period  academic_periods @relation(fields: [id_period], references: [id], onDelete: Restrict)
  subject subject          @relation(fields: [id_subject], references: [code_subject], onDelete: Restrict)
  school  school           @relation(fields: [SIG], references: [SIG], onDelete: Cascade)

  evaluation_plans evaluation_plan[]

  @@map("load_academic")
}

model section {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(50)
  SIG       String @db.VarChar(10)
  id_period Int
  id_year   Int
  capacity  Int    @default(35)
  guide_id  Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  school school           @relation(fields: [SIG], references: [SIG], onDelete: Cascade)
  period academic_periods @relation(fields: [id_period], references: [id], onDelete: Restrict)
  year   year             @relation(fields: [id_year], references: [id], onDelete: Restrict)
  guide  teacher          @relation(fields: [guide_id], references: [id], onDelete: Restrict)

  enrollments    enrollment[]
  load_academics load_academic[]

  @@map("sections")
}

model enrollment {
  id         Int               @id @default(autoincrement())
  id_student Int
  id_section Int?
  id_period  Int?
  status     enrollment_status @default(activo)
  id_year    Int?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  student student           @relation(fields: [id_student], references: [id], onDelete: Restrict)
  section section?          @relation(fields: [id_section], references: [id], onDelete: Restrict)
  year    year?             @relation(fields: [id_year], references: [id], onDelete: Restrict)
  period  academic_periods? @relation(fields: [id_period], references: [id], onDelete: Restrict)

  @@unique([id_student, id_period], name: "unique_student_period")
  @@map("enrollments")
}

model evaluation_plan {
  id               Int @id @default(autoincrement())
  id_load_academic Int
  id_lapse         Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  load_academic load_academic            @relation(fields: [id_load_academic], references: [id], onDelete: Restrict)
  lapse         lapse                    @relation(fields: [id_lapse], references: [id], onDelete: Restrict)
  details       evaluation_plan_detail[]

  @@unique([id_load_academic, id_lapse])
  @@map("evaluation_plans")
}

model evaluation_plan_detail {
  id                 Int      @id @default(autoincrement())
  id_evaluation_plan Int
  date               DateTime @db.Date
  referent_teorical  String   @db.Text
  activity           String   @db.Text
  technical          String   @db.Text
  instrument         String   @db.Text
  porcentage         Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  evaluation_plan evaluation_plan @relation(fields: [id_evaluation_plan], references: [id], onDelete: Restrict)
  grades          grade[]

  @@map("evaluation_plan_details")
}

model grade {
  id            Int     @id @default(autoincrement())
  id_evaluation Int
  id_student    Int
  grade         Decimal @db.Decimal(4, 2)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  evaluation evaluation_plan_detail @relation(fields: [id_evaluation], references: [id], onDelete: Restrict)
  student    student                @relation(fields: [id_student], references: [id], onDelete: Restrict)

  @@unique([id_student, id_evaluation], name: "unique_student_evaluation")
  @@map("grades")
}

enum pending_subject_status {
  Aprobada
  Reprobado
}

model pending_subject {
  id               Int                     @id @default(autoincrement())
  id_student       Int
  id_subject       String                  @db.VarChar(20)
  id_period_origin Int
  status           pending_subject_status?

  student       student          @relation(fields: [id_student], references: [id])
  subject       subject          @relation(fields: [id_subject], references: [code_subject])
  period_origin academic_periods @relation(fields: [id_period_origin], references: [id])

  @@map("pending_subjects")
}

model auth_token {
  id         Int      @id @default(autoincrement())
  id_user    Int
  token      String   @db.VarChar(255)
  expires_at DateTime
  created_at DateTime @default(now())

  user users @relation(fields: [id_user], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}